# Copy this file to .env and replace SECRET_KEY with a random secret.
SECRET_KEY=replace-with-python-secrets-token-hex-32
ADMIN_USERNAMES=admin
APP_HOST=0.0.0.0
APP_PORT=5000
CNS_INSTANCE_DIR=instance
# Optional durable crypto-key mode for hosted deployments. Set this to the
# 64-character hex form of the original instance/keys/aes_master.key. When set,
# wrapped account signing keys and the transport key are stored encrypted in DB.
# CNS_MASTER_KEY=64-hex-characters-from-original-master-key

# Optional hosted database (Supabase PostgreSQL). Leave unset to use local SQLite.
# Paste the Supabase connection string here and append ?sslmode=require.
# DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require

# Optional persistent file bytes (recommended for Render). Create/use a private
# Supabase Storage bucket; the app creates this bucket if it does not exist.
# Use the project's secret key (recommended) or legacy service_role key as a
# private server environment secret; never expose either key in frontend code.
# SUPABASE_URL=https://project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=cns-shared-files

# Recommended for the three-VM browser lab. Generate a local certificate first:
# python3 scripts/generate_lab_tls.py --ip 192.168.56.102
REQUIRE_HTTPS=1
SESSION_COOKIE_SECURE=1
TLS_CERT_FILE=instance/tls/lab.crt
TLS_KEY_FILE=instance/tls/lab.key
# For a public deployment behind Caddy: REQUIRE_HTTPS=0, TRUST_PROXY=1,
# TLS is terminated by Caddy, and Gunicorn must bind only to 127.0.0.1.
TRUST_PROXY=0

MAX_CONTENT_LENGTH=12582912
MAX_SCAN_BYTES=10485760
CLAMSCAN_PATH=clamscan
# Optional: install clamav-daemon for faster repeat scans using its loaded signature database.
CLAMDSCAN_PATH=clamdscan
CLAMSCAN_TIMEOUT=120
SECURITY_SCAN_TIMEOUT_SECONDS=30
# Optional URL reputation provider; enter credentials only in your private .env.
# A URL is sent only when that scan's user explicitly opts in.
GOOGLE_SAFE_BROWSING_API_KEY=
# Optional: enables per-scan VirusTotal hash lookups and consent-based sample uploads.
# Uploaded samples can be shared publicly; never submit confidential or personal files.
VIRUSTOTAL_API_KEY=
